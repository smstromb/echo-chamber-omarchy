{
  "name": "echo-chamber-omarchy",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "main": "app/main.cjs",
  "description": "Independent Echo Chamber client and Omarchy shell plugin",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node test/desktop.mjs",
    "test:auth": "node test/auth.mjs",
    "install:desktop": "python3 scripts/install.py",
    "test:media": "node test/media.mjs",
    "preview": "python3 -m http.server 4173 --bind 127.0.0.1 --directory dist",
    "test:install": "python3 -m unittest discover -s test -p \"*_test.py\"",
    "package:linux": "npm run build && python3 scripts/package.py",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@tabler/icons": "^3.46.0",
    "livekit-client": "2.22.2"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.58.0",
    "prettier": "^3.9.6",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smstromb/echo-chamber-omarchy.git"
  },
  "homepage": "https://github.com/smstromb/echo-chamber-omarchy#readme",
  "bugs": {
    "url": "https://github.com/smstromb/echo-chamber-omarchy/issues"
  },
  "license": "MIT"
}
